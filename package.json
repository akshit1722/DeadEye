{
  "name": "deadeye-cyclone-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Cyclone Early Warning, Monitoring, and Educational Dashboard Monorepo",
  "scripts": {
    "dev:frontend": "npm run dev --prefix frontend",
